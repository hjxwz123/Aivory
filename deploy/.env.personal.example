# --------------------------------------------------------------------------- #
# Aivory personal deployment: SQLite + embedded vectors + in-process cache    #
# --------------------------------------------------------------------------- #
# Copy to .env.personal and use it with docker-compose.personal.yml.           #
# Do not add DATABASE_URL, VECTOR_BACKEND, REDIS_URL or QDRANT_URL here: the   #
# personal Compose file pins those values so the profile stays self-contained. #
# --------------------------------------------------------------------------- #

# ============ Images =========================================================
IMAGE_OWNER=hjxwz123
# IMAGE_REGISTRY=ghcr.io
IMAGE_TAG=latest

# ============ Authentication (REQUIRED) ======================================
# Generate once with: openssl rand -hex 32
# Keep this value stable across restarts or existing sessions become invalid.
JWT_SECRET=change-me-to-a-long-random-secret

# ============ Persistent personal data ======================================
# Holds aivory.db (business rows + vectors), uploads, artifacts and backups.
DATA_DIR=./data-personal
BACKUP_DIR=/app/data/backups
MAX_BACKUP_BYTES=21474836480
# AIVORY_LOCAL_STORAGE_DIR=/app/data/uploads/object-storage

# Seed a mock channel for evaluation. Disable after adding a real channel.
ENABLE_MOCK_PROVIDER=false

# ============ Embeddings ======================================================
# SQLite is the vector STORE. These settings choose how embeddings are created.
# Blank values use the bundled local 256-dim hash embedder. For higher-quality
# semantic retrieval, configure an OpenAI-compatible embeddings endpoint here or
# in the admin UI and keep EMBEDDING_DIM equal to the model's actual output.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ============ Optional search and parsing ====================================
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=
MINERU_API_URL=https://mineru.net
MINERU_API_KEY=

# ============ Optional Python sandbox ========================================
# Default: leave both blank and the personal profile starts only app. Python is
# unavailable until an external sandbox or the optional bundled profile is used.
#
# External sandbox: set its HTTPS URL and matching Bearer key.
# SANDBOX_BASE_URL=https://sandbox.example.com
# SANDBOX_API_KEY=
#
# Bundled personal sandbox: uncomment the next two lines, then start Compose
# with --profile sandbox. The profile mounts /var/run/docker.sock on the host.
# SANDBOX_BASE_URL=http://sandbox:8000
# SANDBOX_API_KEY=aivory-personal-sandbox
# Optional sidecar limits: SANDBOX_MEMORY=2g, SANDBOX_CPUS=1,
# SANDBOX_MAX_SESSIONS=4, SANDBOX_WORKSPACE_SIZE=512m.
